/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    metagenomicspipeline Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Infrastructure params: read by config files, so they must be defined here
// (config is evaluated before main.nf and cannot see its defaults).
// Analysis params are declared, typed, in the params block of main.nf.
params {
    // Output options
    outdir                     = null
    publish_dir_mode           = 'copy'
    publish_mergedreads        = 'symlink'   // publish mode for host-filtered and merged reads
    trace_report_suffix        = new java.text.SimpleDateFormat('yyyy-MM-dd_HH-mm-ss').format(new java.util.Date())

    // References
    igenomes_base              = 's3://ngi-igenomes/igenomes'
    igenomes_ignore            = false

    // MultiQC options
    multiqc_title              = null
    max_multiqc_email_size     = '25.MB'

    // Boilerplate options
    monochrome_logs            = false

    // Config options
    config_profile_name        = null
    config_profile_description = null
    config_profile_contact     = null
    config_profile_url         = null
    custom_config_version      = 'master'
    custom_config_base         = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
}

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

// Load institutional config profiles
includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"

// Load iGenomes reference paths (--genome), unless --igenomes_ignore
includeConfig !params.igenomes_ignore ? 'conf/igenomes.config' : '/dev/null'

profiles {
    debug {
        dumpHashes             = true
        process.beforeScript   = 'echo $HOSTNAME'
        cleanup                = false
    }
    conda {
        conda.enabled          = true
        docker.enabled         = false
        singularity.enabled    = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
        apptainer.enabled      = false
    }
    mamba {
        conda.enabled          = true
        conda.useMamba         = true
        docker.enabled         = false
        singularity.enabled    = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
        apptainer.enabled      = false
    }
    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        conda.enabled          = false
        singularity.enabled    = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
        apptainer.enabled      = false
    }
    arm {
        // Apple Silicon: several tools have no arm64 builds, so run x86_64 images / conda envs through Rosetta
        docker.runOptions      = '-u $(id -u):$(id -g) --platform=linux/amd64'
        conda.createOptions    = '--platform osx-64'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.pullTimeout = 60.min
        conda.enabled          = false
        docker.enabled         = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
        apptainer.enabled      = false
    }
    podman {
        podman.enabled         = true
        conda.enabled          = false
        docker.enabled         = false
        singularity.enabled    = false
        shifter.enabled        = false
        charliecloud.enabled   = false
        apptainer.enabled      = false
    }
    shifter {
        shifter.enabled        = true
        conda.enabled          = false
        docker.enabled         = false
        singularity.enabled    = false
        podman.enabled         = false
        charliecloud.enabled   = false
        apptainer.enabled      = false
    }
    charliecloud {
        charliecloud.enabled   = true
        conda.enabled          = false
        docker.enabled         = false
        singularity.enabled    = false
        podman.enabled         = false
        shifter.enabled        = false
        apptainer.enabled      = false
    }
    apptainer {
        apptainer.enabled      = true
        apptainer.autoMounts   = true
        apptainer.pullTimeout  = 60.min
        conda.enabled          = false
        docker.enabled         = false
        singularity.enabled    = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
    }
    test      { includeConfig 'conf/test.config'      }
    test_full { includeConfig 'conf/test_full.config' }

    snellius {
        process {
            executor = 'slurm'
            clusterOptions = '-p genoa'
        }
        executor {
            name = 'slurm'
            queueSize = 70
            submitRateLimit = '10 sec'
            jobName = { "${task.name}".replaceAll('[():\\s]', '_') }
        }
        singularity.enabled    = true
        singularity.autoMounts = true
        conda.enabled          = false
        docker.enabled         = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
        apptainer.enabled      = false
    }
    beast {
        process {
            resourceLimits = [ cpus: 80, memory: 200.GB, time: 240.h ]
            withLabel: 'metaphlan' {
                maxForks = 2
            }
            withLabel: 'humann' {
                maxForks = 2
            }
        }
    }
    local {
        process {
            withLabel: 'metaphlan' {
                maxForks = 2
            }
            withLabel: 'humann' {
                maxForks = 2
            }
        }
    }
    dkfz_plus {
        singularity.enabled    = true
        singularity.autoMounts = true
        process {
            resourceLimits = [ cpus: 30, memory: 450.GB, time: 48.h ]
            executor = 'lsf'
            scratch  = '$SCRATCHDIR/$LSB_JOBID'
        }
        executor {
            name            = 'lsf'
            perTaskReserve  = false
            perJobMemLimit  = true
            queueSize       = 10
            submitRateLimit = '3 sec'
        }
    }
}

// Set default registry for Apptainer, Docker, Podman and Singularity independent of -profile
// Will not be used unless Apptainer / Docker / Podman / Singularity are enabled
// Set to your registry if you have a mirror of containers
apptainer.registry   = 'quay.io'
docker.registry      = 'quay.io'
podman.registry      = 'quay.io'
singularity.registry = 'quay.io'

// Nextflow plugins
plugins {
    id 'nf-schema@3.0.0' // Validation of pipeline parameters and creation of an input channel from a sample sheet
}

validation {
    monochromeLogs      = params.monochrome_logs
    defaultIgnoreParams = ['genomes']   // set by conf/igenomes.config, not by users
}

// Export these variables to prevent local Python/R libraries from conflicting with those in the container
// The JULIA depot path has been adjusted to a fixed path `/usr/local/share/julia` that needs to be used for packages in the container.
// See https://apeltzer.github.io/post/03-julia-lang-nextflow/ for details on that. Once we have a common agreement on where to keep Julia packages, this is adjustable.
env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
}

// Workflow outputs (see the output block in main.nf) replace per-process publishDir
outputDir            = params.outdir
workflow.output.mode = params.publish_dir_mode

// Capture exit codes from upstream processes when piping
process.shell = ['/bin/bash', '-euo', 'pipefail']

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

manifest {
    name            = 'metagenomicspipeline'
    author          = """Barbara Verhaar"""
    homePage        = 'https://github.com/barbarahelena/metagenomicspipeline'
    description     = """shotgun metagenomics pipeline to obtain relative abundances and pathway abundances"""
    mainScript      = 'main.nf'
    nextflowVersion = '!>=26.10.0'
    version         = '2.0.0dev'
    doi             = 'https://doi.org/10.5281/zenodo.10663325'
}

// Load modules.config for DSL2 module specific options
includeConfig 'conf/modules.config'
