/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.
    All data is in assets/testdata: reads simulated from a mock gut community with a known
    composition (one sample with two runs, to test run merging), a small human reference for
    host removal and a tiny Kraken2/Bracken database of the community (assets/testdata/make_testdata.sh).
    MetaPhlAn and HUMAnN are skipped: their databases are tens of GB.

    Use as follows:
        nextflow run barbarahelena/metagenomicspipeline -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

// Limit resources so that this can run on GitHub Actions
process {
    resourceLimits = [ cpus: 2, memory: 8.GB, time: 6.h ]

    withName: 'KRAKEN2_KRAKEN2|BRACKEN_BUILD' {
        cpus   = 2
        memory = 2.GB
        queue  = null
    }
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    input                      = "${projectDir}/assets/testdata/samplesheet_test.csv"
    fasta                      = "${projectDir}/assets/testdata/genome.fasta"
    kraken2_db                 = "${projectDir}/assets/testdata/kraken2_bracken"
    bracken_readlength         = 150
    subsamplelevel             = 5000
    perform_runmerging         = true
    skip_metaphlan             = true
    skip_humann                = true
    skip_kraken                = false
}
